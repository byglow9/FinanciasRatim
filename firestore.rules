rules_version = '2';

// Regras por dono (casal). O dono dos dados e o id do casal (claim "hid" no ID token),
// nunca o uid de cada pessoa (D-02, D-03). Os dois logins do casal enxergam tudo (D-05):
// a regra nao distingue "person". Tudo que nao esta listado aqui e negado por padrao.
// Escrita em bankConnections, bankImports e cards e so do servidor (Admin SDK ignora regras).
// cardSettings (dias de fechamento e vencimento, apelido, meses pagos) e do dono: o servidor nunca a escreve.
// Fase 8: ao criar, settings so aceita o id igual ao hid e limitAlerts e vintemInsights so aceitam id
// com o prefixo hid + "__" (o mesmo que scopedId de shared/core/household.js produz). Documentos
// antigos (settings/main e ids sem prefixo) seguem legiveis, atualizaveis e apagaveis pelo dono.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember() {
      return request.auth != null
        && request.auth.token.hid is string
        && request.auth.token.hid.size() > 0;
    }
    function ownsExisting() { return resource.data.ownerId == request.auth.token.hid; }
    function ownsIncoming() { return request.resource.data.ownerId == request.auth.token.hid; }
    // Id do documento a criar: um grupo nunca ocupa nem tranca o documento de outro.
    // O hid do token so tem letras, numeros, hifen e sublinhado, entao entra na expressao sem escape.
    function idOk(col, id) {
      return col == 'settings' ? id == request.auth.token.hid
        : col in ['limitAlerts', 'vintemInsights']
          ? id.matches('^' + request.auth.token.hid + '__.+$')
          : true;
    }
    function clientCollections() {
      return ['transactions', 'fixedExpenses', 'fixedExpensePayments', 'savings', 'goals',
              'goalContributions', 'events', 'eventCategories', 'notes', 'settings', 'limitAlerts',
              'vintemInsights', 'cardSettings'];
    }

    // Colecoes que o cliente le e escreve
    match /{col}/{id} {
      allow read, delete: if isMember() && col in clientCollections() && ownsExisting();
      allow create: if isMember() && col in clientCollections() && ownsIncoming() && idOk(col, id);
      allow update: if isMember() && col in clientCollections() && ownsExisting()
        && request.resource.data.ownerId == resource.data.ownerId;
      // O cliente cria settings/{hid} e o marcador de limitAlerts quando ainda nao existem: le o
      // documento antes de cria-lo (get de documento inexistente). So estas duas colecoes, e so com
      // o id que ele mesmo poderia criar.
      allow get: if isMember() && col in ['settings', 'limitAlerts'] && resource == null && idOk(col, id);
    }

    // Perfil do grupo: o cliente so le o proprio (get, vale tambem para o casal legado, que ainda
    // nao tem o documento). Nenhuma escrita e nenhuma listagem pelo cliente.
    match /households/{hid} {
      allow get: if isMember() && hid == request.auth.token.hid;
    }

    // Somente leitura para o cliente; a escrita e do servidor
    match /{col}/{id} {
      allow read: if isMember() && col in ['bankConnections', 'bankImports', 'cards'] && ownsExisting();
    }
  }
}
