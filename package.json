{
  "name": "sitefinancias-temp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:amigo": "vite --mode amigo",
    "build": "tsc -b && vite build",
    "build:amigo": "tsc -b && vite build --mode amigo",
    "build:release-a": "VITE_OWNER_SCOPED_READS=false npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "icons": "node scripts/build-icons.mjs",
    "test:core": "node --test \"shared/**/*.test.js\"",
    "test:core:tz": "TZ=UTC node --test \"shared/**/*.test.js\" && TZ=Asia/Tokyo node --test \"shared/**/*.test.js\"",
    "test:server": "npm --prefix server test",
    "test:static": "node --test \"test/static/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-coinki \"node --test test/rules/*.test.js\"",
    "test:emu": "firebase emulators:exec --only auth,firestore --project demo-coinki \"node --test --test-concurrency=1 server/test/emu/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "firebase": "^13.4.0",
    "lucide-react": "^0.577.0",
    "pluggy-connect-sdk": "^2.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
