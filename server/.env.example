# Credenciais da aplicacao criada em dashboard.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# JSON da conta de servico do Firebase em uma unica linha
# (Console Firebase > Configuracoes do projeto > Contas de servico > Gerar nova chave privada)
FIREBASE_SERVICE_ACCOUNT=

# OBRIGATORIA: origens autorizadas a chamar a API, separadas por virgula (lista fechada).
# O servidor nao sobe sem ela e recusa com 403 qualquer Origin fora da lista.
# Os ID tokens do Firebase (Authorization: Bearer) substituiram a antiga chave compartilhada
# da API, que foi removida: nao ha mais variavel de chave a definir.
ALLOWED_ORIGINS=https://financias-ratimbum.web.app,http://localhost:5173

# Intervalo da sincronizacao automatica em horas (0 desliga)
SYNC_INTERVAL_HOURS=6

# Segredo do webhook da Pluggy (opcional): sem ele a rota POST /webhooks/pluggy nao existe e o
# servidor sincroniza so pelo agendador. Gere com: openssl rand -hex 32
# O valor vive so no Railway e no shell do dono, e e o mesmo usado pelo script de registro.
PLUGGY_WEBHOOK_SECRET=
# Rotacao: atualize os 4 webhooks na Pluggy com o valor novo, depois troque PLUGGY_WEBHOOK_SECRET
# e mantenha o valor antigo aqui durante a janela.
# PLUGGY_WEBHOOK_SECRET_PREVIOUS=
